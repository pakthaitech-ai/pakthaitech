// PAKTHAI TECH — low-volume, owner-authorized B2B outreach.
// Sends only to the explicitly approved seed list below. Max 3 emails per Pakistan business day.
// Stops on any reply/opt-out. Never quotes prices, promises stock, or commits to orders.
import { getSession } from "./auth-session.js";

const json = (data, status = 200) => new Response(JSON.stringify(data), {
  status, headers: { "content-type": "application/json; charset=utf-8", "Cache-Control": "no-store" }
});
const STORE = "https://pakthai-tech-store.pages.dev/";
const MAX_SENDS_PER_RUN = 3;

const SEEDS = [
  { name:"Noresto Co., Ltd.", type:"seller", email:"info@noresto.com", url:"https://noresto.com/", market:"Thailand" },
  { name:"Supreme Distribution Public Company Limited", type:"seller", email:"sale@supreme.co.th", url:"https://www.supreme.co.th/en/our-businesses/distribution-and-installation-business/hardware-and-peripheral", market:"Thailand" },
  { name:"Computer Peripheral and Supplies Ltd. (CPS)", type:"seller", email:"sales.dept@cps.co.th", url:"https://www.cps.co.th/en/contactus", market:"Thailand" },
  { name:"Wilcon Distribution Co., Ltd.", type:"seller", email:"salesteam@wcdt.co.th", url:"https://wcdt.co.th/", market:"Thailand" },
  { name:"Greenwill Solution", type:"seller", email:"sales@greenwillsolution.com", url:"https://store.greenwillsolution.com/it-hardware-software-supply", market:"Thailand" },
  { name:"Tech Global", type:"buyer_channel", email:"sales@techglobal.com.pk", url:"https://techglobal.com.pk/contact", market:"Pakistan" },
  { name:"Redzone Pakistan", type:"buyer_channel", email:"Laraib@doublemvgapalace.pk", url:"https://redzonepk.com/contact", market:"Pakistan" },
  { name:"New Technologies", type:"buyer_channel", email:"kashif@newtechpk.com", url:"https://www.newtechpk.com/contactus", market:"Pakistan" }
];

async function ensureSchema(db) {
  await db.prepare(`CREATE TABLE IF NOT EXISTS outreach_campaigns (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    company_name TEXT NOT NULL,
    prospect_type TEXT NOT NULL,
    recipient TEXT NOT NULL UNIQUE,
    source_url TEXT NOT NULL,
    market TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'queued',
    touch_count INTEGER NOT NULL DEFAULT 0,
    first_sent_at TEXT,
    last_sent_at TEXT,
    next_action_at TEXT,
    last_message_id TEXT,
    replied_at TEXT,
    last_error TEXT,
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
  )`).run();
  await db.prepare(`CREATE TABLE IF NOT EXISTS outreach_suppressions (
    email TEXT PRIMARY KEY,
    reason TEXT NOT NULL,
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
  )`).run();
  for (const seed of SEEDS) {
    await db.prepare(`INSERT OR IGNORE INTO outreach_campaigns
      (company_name,prospect_type,recipient,source_url,market,status,next_action_at)
      VALUES(?,?,?,?,?,'queued',?)`)
      .bind(seed.name,seed.type,seed.email,seed.url,seed.market,new Date().toISOString()).run();
  }
}

function addBusinessDays(startValue, count) {
  const d = new Date(startValue);
  let added = 0;
  while (added < count) {
    d.setUTCDate(d.getUTCDate() + 1);
    // Sunday is skipped; Monday–Saturday are considered business days.
    if (d.getUTCDay() !== 0) added++;
  }
  return d.toISOString();
}

function encodeMime(to, subject, body) {
  const safe = s => String(s || "").replace(/[\r\n]+/g, " ").trim();
  const bytes = new TextEncoder().encode([
    "From: pakthaitech@gmail.com",
    "To: " + safe(to),
    "Subject: " + safe(subject),
    "Reply-To: pakthaitech@gmail.com",
    "MIME-Version: 1.0",
    "Content-Type: text/plain; charset=UTF-8",
    "",
    body
  ].join("\r\n"));
  let binary = "";
  for (const b of bytes) binary += String.fromCharCode(b);
  return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/g, "");
}

async function getAccessToken(env) {
  if (!env.GOOGLE_CLIENT_ID || !env.GOOGLE_CLIENT_SECRET) throw new Error("Gmail Worker secrets are missing.");
  const auth = await env.DB.prepare("SELECT refresh_token FROM gmail_oauth WHERE id=1").first();
  if (!auth?.refresh_token) throw new Error("Gmail OAuth is not connected.");
  const response = await fetch("https://oauth2.googleapis.com/token", {
    method:"POST", headers:{"content-type":"application/x-www-form-urlencoded"},
    body:new URLSearchParams({client_id:env.GOOGLE_CLIENT_ID,client_secret:env.GOOGLE_CLIENT_SECRET,refresh_token:auth.refresh_token,grant_type:"refresh_token"})
  });
  const token = await response.json();
  if (!response.ok || !token.access_token) throw new Error("Gmail access token refresh failed.");
  return token.access_token;
}

function messageFor(row, followup) {
  if (row.prospect_type === "seller") {
    if (followup === 0) return {
      subject: "B2B sourcing inquiry from PAKTHAI TECH — IT hardware",
      body: `Hello ${row.company_name} team,

I’m contacting you on behalf of PAKTHAI TECH in Pakistan. We are developing a B2B sourcing channel for computer components, peripherals and IT hardware, and are exploring potential supplier relationships in Thailand.

Could you please share:
• Your current product catalogue and wholesale/dealer price list
• Minimum order quantities and stock/lead times
• Warranty and return terms
• Whether you support export or shipment to Pakistan, and the available shipping/payment terms

At this stage we are only assessing fit and collecting supplier information; no purchase or order is being committed. If relevant, please reply with your catalogue or the right sales contact.

PAKTHAI TECH
pakthaitech@gmail.com
Store: ${STORE}

If this inquiry is not relevant or you prefer no further follow-up, reply STOP and we will remove this address from our outreach list.`
    };
    return {
      subject: followup === 1 ? "Follow-up: PAKTHAI TECH B2B hardware sourcing" : "Final follow-up: PAKTHAI TECH supplier inquiry",
      body: `Hello ${row.company_name} team,

I’m following up on my earlier B2B inquiry about computer components, peripherals and IT hardware supply to Pakistan. If this is within your scope, could you point me to your catalogue, wholesale terms or export contact?

No order or purchase is being committed. If this is not relevant, reply STOP and we will not follow up again.

Regards,
PAKTHAI TECH
pakthaitech@gmail.com
`
    };
  }
  if (followup === 0) return {
    subject: "Pakistan B2B channel inquiry — PAKTHAI TECH",
    body: `Hello ${row.company_name} team,

I’m contacting you on behalf of PAKTHAI TECH. We are exploring B2B channel relationships in Pakistan for computer components, peripherals and IT hardware, including potential sourcing options from Thailand.

Could you let us know which product categories you actively buy or distribute, and whether you are open to reviewing supplier options when a matching product and landed cost are available? If there is a purchasing or category manager, please share the best contact.

We are not claiming current stock or a confirmed price, and this message does not commit either party to an order.

Regards,
PAKTHAI TECH
pakthaitech@gmail.com
Store: ${STORE}

If this is not relevant or you prefer no further follow-up, reply STOP and we will remove this address from our outreach list.`
  };
  return {
    subject: followup === 1 ? "Follow-up: PAKTHAI TECH channel inquiry" : "Final follow-up: PAKTHAI TECH channel inquiry",
    body: `Hello ${row.company_name} team,

A brief follow-up to ask whether your team would be open to reviewing potential B2B supply options for computer components and IT hardware. If not relevant, no action is needed; reply STOP if you prefer no further contact.

Regards,
PAKTHAI TECH
pakthaitech@gmail.com
`
  };
}

async function findReply(env, token, row) {
  if (!row.first_sent_at) return null;
  const after = Math.max(0, Math.floor(new Date(row.first_sent_at).getTime() / 1000) - 1);
  const q = "in:inbox from:" + row.recipient + " after:" + after;
  const url = new URL("https://gmail.googleapis.com/gmail/v1/users/me/messages");
  url.searchParams.set("q", q);
  url.searchParams.set("maxResults", "5");
  const response = await fetch(url.toString(), { headers:{Authorization:"Bearer " + token} });
  const list = await response.json();
  if (!response.ok) throw new Error("Gmail reply check failed.");
  const items = list.messages || [];
  if (!items.length) return null;
  const item = items[0];
  const fullResponse = await fetch("https://gmail.googleapis.com/gmail/v1/users/me/messages/" + encodeURIComponent(item.id) + "?format=full", {headers:{Authorization:"Bearer " + token}});
  const full = await fullResponse.json();
  if (!fullResponse.ok) return { message_id:item.id, text:String(item.snippet || "") };
  const headers = full.payload?.headers || [];
  const from = headers.find(h => String(h.name).toLowerCase() === "from")?.value || "";
  const snippet = String(full.snippet || "");
  return { message_id:item.id, text:snippet + " " + from };
}

export async function runScheduledOutreach(env) {
  await ensureSchema(env.DB);
  const localPakistan = new Date(Date.now() + 5 * 60 * 60 * 1000);
  if (localPakistan.getUTCDay() === 0) return {ok:true, skipped:true, reason:"Sunday in Pakistan; outreach paused."};
  const now = new Date().toISOString();
  const runId = now;
  let token;
  try { token = await getAccessToken(env); }
  catch (e) {
    await env.DB.prepare("INSERT INTO settings(key,value) VALUES('outreach_last_status',?) ON CONFLICT(key) DO UPDATE SET value=excluded.value").bind(JSON.stringify({ok:false,ran_at:now,error:String(e.message||e)})).run();
    return {ok:false, sent:0, error:String(e.message||e)};
  }
  let replies = 0, sent = 0, skipped = 0;
  const active = await env.DB.prepare("SELECT * FROM outreach_campaigns WHERE status IN ('queued','active','awaiting_reply') ORDER BY id ASC LIMIT 100").all();
  for (const row of (active.results || [])) {
    try {
      const reply = await findReply(env, token, row);
      if (reply) {
        const text = String(reply.text || "");
        const stop = /\bstop\b|unsubscribe|do not contact|remove me/i.test(text);
        await env.DB.prepare("UPDATE outreach_campaigns SET status=?,replied_at=?,next_action_at=NULL,last_message_id=?,updated_at=CURRENT_TIMESTAMP WHERE id=?")
          .bind(stop ? "unsubscribed" : "replied", new Date().toISOString(), reply.message_id, row.id).run();
        if (stop) await env.DB.prepare("INSERT OR IGNORE INTO outreach_suppressions(email,reason) VALUES(?,?)").bind(row.recipient,"reply_opt_out").run();
        await env.DB.prepare("INSERT INTO notifications(type,channel,recipient,subject,message,related_type,related_id,status) VALUES('internal','dashboard','Owner',?,?, 'outreach_reply',?,'pending')")
          .bind("B2B reply: " + row.company_name, "Reply detected from " + row.recipient + ". Status: " + (stop ? "opt-out; no further contact" : "reply received; follow-up stopped") + ". Please review the Gmail inbox and respond personally.", row.id).run();
        replies++;
      }
    } catch (e) {
      await env.DB.prepare("UPDATE outreach_campaigns SET last_error=?,updated_at=CURRENT_TIMESTAMP WHERE id=?").bind(String(e.message||e).slice(0,250),row.id).run();
    }
  }
  const due = await env.DB.prepare("SELECT * FROM outreach_campaigns WHERE status IN ('queued','active') AND next_action_at IS NOT NULL AND next_action_at<=? AND touch_count<3 ORDER BY CASE WHEN touch_count>0 THEN 0 ELSE 1 END,id ASC LIMIT 20").bind(now).all();
  for (const row of (due.results || [])) {
    if (sent >= MAX_SENDS_PER_RUN) break;
    if (await env.DB.prepare("SELECT email FROM outreach_suppressions WHERE email=?").bind(row.recipient).first()) {
      await env.DB.prepare("UPDATE outreach_campaigns SET status='unsubscribed',next_action_at=NULL,updated_at=CURRENT_TIMESTAMP WHERE id=?").bind(row.id).run();
      skipped++; continue;
    }
    try {
      const currentReply = await findReply(env, token, row);
      if (currentReply) {
        await env.DB.prepare("UPDATE outreach_campaigns SET status='replied',replied_at=?,next_action_at=NULL,last_message_id=?,updated_at=CURRENT_TIMESTAMP WHERE id=?").bind(new Date().toISOString(),currentReply.message_id,row.id).run();
        await env.DB.prepare("INSERT INTO notifications(type,channel,recipient,subject,message,related_type,related_id,status) VALUES('internal','dashboard','Owner',?,?, 'outreach_reply',?,'pending')")
          .bind("B2B reply: " + row.company_name, "Reply detected from " + row.recipient + ". Automated follow-up stopped; please review Gmail.", row.id).run();
        replies++; continue;
      }
      const touch = Number(row.touch_count || 0);
      const mail = messageFor(row, touch);
      const raw = encodeMime(row.recipient,mail.subject,mail.body);
      const response = await fetch("https://gmail.googleapis.com/gmail/v1/users/me/messages/send", {
        method:"POST",headers:{Authorization:"Bearer " + token,"content-type":"application/json"},
        body:JSON.stringify({raw})
      });
      const result = await response.json().catch(()=>({}));
      if (!response.ok) throw new Error("Gmail send failed: " + String(result?.error?.message || response.status).slice(0,180));
      const sentAt = new Date().toISOString();
      const count = touch + 1;
      const status = count >= 3 ? "awaiting_reply" : "active";
      const next = count === 1 ? addBusinessDays(sentAt,3) : (count === 2 ? addBusinessDays(sentAt,4) : null);
      await env.DB.prepare("UPDATE outreach_campaigns SET status=?,touch_count=?,first_sent_at=COALESCE(first_sent_at,?),last_sent_at=?,next_action_at=?,last_message_id=?,last_error=NULL,updated_at=CURRENT_TIMESTAMP WHERE id=?")
        .bind(status,count,sentAt,sentAt,next,result.id || null,row.id).run();
      sent++;
    } catch (e) {
      await env.DB.prepare("UPDATE outreach_campaigns SET last_error=?,updated_at=CURRENT_TIMESTAMP WHERE id=?").bind(String(e.message||e).slice(0,250),row.id).run();
    }
  }
  const status = {ok:true,ran_at:runId,sent,replies,skipped,checked:(active.results||[]).length,send_limit:MAX_SENDS_PER_RUN,followup_days:[3,7],note:"Email only; no WhatsApp, purchases, quotes, stock or delivery commitments."};
  await env.DB.prepare("INSERT INTO settings(key,value) VALUES('outreach_last_status',?) ON CONFLICT(key) DO UPDATE SET value=excluded.value").bind(JSON.stringify(status)).run();
  return status;
}

export async function handleOutreachRequest(request, env) {
  const url = new URL(request.url);
  if (!url.pathname.startsWith("/api/outreach")) return null;
  if (request.method === "OPTIONS") return new Response(null,{headers:{"Access-Control-Allow-Methods":"GET,OPTIONS","Access-Control-Allow-Headers":"Content-Type,Authorization"}});
  const session = await getSession(request,env);
  if (session?.role !== "owner") return json({ok:false,error:"Owner login required for outreach status."},403);
  await ensureSchema(env.DB);
  if (url.pathname === "/api/outreach/status" && request.method === "GET") {
    const [rows,last] = await Promise.all([
      env.DB.prepare("SELECT id,company_name,prospect_type,recipient,market,status,touch_count,first_sent_at,last_sent_at,next_action_at,replied_at,last_error FROM outreach_campaigns ORDER BY id").all(),
      env.DB.prepare("SELECT value FROM settings WHERE key='outreach_last_status'").first()
    ]);
    return json({ok:true,schedule:"Daily at 09:00 Pakistan time, Monday–Saturday",max_new_or_followup_emails_per_run:MAX_SENDS_PER_RUN,followups_business_days:[3,7],campaigns:rows.results||[],last_run:last?.value ? JSON.parse(last.value) : null});
  }
  return json({ok:false,error:"Route not found."},404);
}
